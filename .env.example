# Contact form submission endpoint (Formspree, Web3Forms, Getform, Basin, …).
# The NEXT_PUBLIC_ prefix inlines this into the client bundle at BUILD time —
# for a static export it must be set before `next build` runs.
NEXT_PUBLIC_FORM_ENDPOINT=

# Pre-registration (launch waitlist) endpoint. Point this at a real list
# provider — ConvertKit, Buttondown, Loops, MailerLite — so subscribers land in
# a list you can segment and mail on launch day, and so they get a confirmation
# of their own. It receives {"email", "source"} as JSON.
#
# Left empty, the modal falls back to emailing the contact inbox via EmailJS.
# That captures the address but is NOT a list: nothing to send from at launch
# except copy-paste, and a typo'd address is lost with no receipt to the person
# who typed it. Set this before launch.
#
# Inlined at BUILD time, so it must be set before `next build`.
NEXT_PUBLIC_PREREGISTER_ENDPOINT=

# RAG support chatbot endpoint — the deployed Cloudflare Worker's /chat URL.
# Powers the SupportChatbot widget via @ai-sdk/react useChat. Inlined at BUILD
# time. Left empty, the widget falls back to http://localhost:8787/chat (local dev).
NEXT_PUBLIC_CHAT_API=
